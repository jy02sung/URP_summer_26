<?xml version="1.0"?>
<model>
  <name>Graspable Box with ArUco Marker 26 (10cm)</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>
  <description>
    Dynamic 10x10x10cm pick object for dual-arm grasp testing. Carries a
    5cm ArUco id=26 marker (reusing the texture/material from the
    aruco_marker_26 model) centered on the -X face, facing the head camera
    when placed in front of it. Sized for two-hand straddle grasping.
  </description>
</model>
