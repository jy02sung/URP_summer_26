    <limit effort="12" lower="-0.9" upper="0.9" velocity="4"/>
  </joint>
  <link name="R_wrist_ik_frame">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1E-06" ixy="0" ixz="0" iyy="1E-06" iyz="0" izz="1E-06"/>
    </inertial>
  </link>
  <joint name="R_wrist_ik_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 -0.10"/>
    <parent link="R_wrist_yaw"/>
    <child link="R_wrist_ik_frame"/>
  </joint>
  <link name="R_EE">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 -0.003514"/>
      <mass value="0.15"/>
      <inertia ixx="5.5E-05" ixy="0" ixz="0" iyy="5.5E-05" iyz="0" izz="6.4E-05"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://dual_arm/meshes/R_EE.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.298039215686275 0.298039215686275 0.298039215686275 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://dual_arm/meshes/R_EE.STL"/>
      </geometry>
    </collision>
    <!-- 파지 안정성 보강용 평면 접촉 패드 (L_EE 쪽 설명 참고, mesh 반경 ~3.25cm). 이전 주석은
         "R_EE 로컬 Y축이 dot~0.99로 거의 완벽히 정렬"이라고 기록했으나, 이는 grasp_offset=0.043
         기준 stale 수치였다. 2026-07-13 fk_debug(현재 코드의 grasp_offset=0.040/STANDOFF_Y=0.15
         그대로 재현)로 재계산하니 실제로는 dot=0.955(약 17.2° 어긋남) - L_EE(40.8°)보다는 낫지만
         무시할 수준은 아니다. L_EE와 동일한 방식으로 rpy를 target_local_dir(=R_EE^T*worldY)에
         맞춰 보정한다 (계산: fk_debug.cpp, 일회성 도구, 커밋 안 함). -->
    <!-- 원형 접촉 패드 - L_EE 쪽 설명 참고. 동일한 방식(recompute_pad_rpy.py로 null-space
         적용된 파지 파이프라인 처음부터 재현, compute_tangent_offset.py로 탄젠트 접점 위치
         재계산)으로 rpy/xyz 재계산, dot=1.0 검증. rpy 최종값은 왼쪽과 대칭으로 -7.5° 미세 조정. -->
    <visual name="R_EE_grip_disc_visual">
      <origin rpy="1.817146 -0.000000 2.611848" xyz="0.008658 0.029717 -0.009909"/>
      <geometry>
        <cylinder length="0.01" radius="0.03"/>
      </geometry>
      <material name="grip_pad_orange">
        <color rgba="1.0 0.5 0.0 1"/>
      </material>
    </visual>
    <collision name="R_EE_grip_disc_collision">
      <origin rpy="1.817146 -0.000000 2.611848" xyz="0.008658 0.029717 -0.009909"/>
      <geometry>
        <cylinder length="0.01" radius="0.03"/>
      </geometry>
    </collision>
  </link>
  <joint name="R_EE_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 -0.15"/>
    <parent link="R_wrist_yaw"/>
    <child link="R_EE"/>
    <axis xyz="0 0 0"/>
    <dynamics damping="1"/>
    <limit effort="30" lower="-1.57" upper="1.57" velocity="8.5"/>
  </joint>
  <!-- Contact frame at the center and orientation of the existing jmp grip disc. -->
  <link name="R_grip_frame"/>
  <joint name="R_grip_frame_joint" type="fixed">
    <origin rpy="1.817146 0 2.611848" xyz="0.008658 0.029717 -0.009909"/>
    <parent link="R_EE"/>
    <child link="R_grip_frame"/>
  </joint>
