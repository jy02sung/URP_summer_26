        xyz="0 0.0375 -0.005"
        rpy="-0.206731 -0.022471 -0.215784" />
      <geometry>
        <box size="0.04 0.01 0.04" />
      </geometry>
    </collision>
    <!-- L자형 턱(lip) - L_EE 쪽 설명 참고. 패드와 동일한 보정 rpy를 적용해 상대 배치를 유지한다. -->
    <collision name="R_EE_grip_lip_collision">
      <origin
        xyz="-0.025 0.0475 -0.005"
        rpy="-0.206731 -0.022471 -0.215784" />
      <geometry>
        <box size="0.01 0.01 0.04" />
      </geometry>
    </collision>
