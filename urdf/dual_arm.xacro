  <!-- Head-mounted RGB-D camera -->
  <link
    name="Head_camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.05" />
      <inertia ixx="1E-05" ixy="0" ixz="0" iyy="1E-05" iyz="0" izz="1E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.02" />
      </geometry>
      <material name="camera_marker_red">
        <color rgba="1 0 0 1" />
      </material>
    </visual>
  </link>
  <joint
    name="Head_camera_joint"
    type="fixed">
    <origin
      xyz="0.05 0 0.145"
      rpy="0 0 0" />
    <parent
      link="Head" />
    <child
      link="Head_camera_link" />
  </joint>

  <!-- Optical frame: rotates to ROS REP-103 camera-optical convention (x-right, y-down, z-forward) -->
  <link name="Head_camera_link_optical" />
  <joint
    name="Head_camera_optical_joint"
    type="fixed">
    <origin
      xyz="0 0 0"
      rpy="-1.5707963 0 -1.5707963" />
    <parent
      link="Head_camera_link" />
    <child
      link="Head_camera_link_optical" />
  </joint>

  <gazebo reference="Head_camera_link">
    <sensor type="depth" name="head_camera">
      <update_rate>20</update_rate>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>10.0</far>
        </clip>
      </camera>
      <plugin name="head_camera_controller" filename="libgazebo_ros_openni_kinect.so">
        <baseline>0.1</baseline>
        <alwaysOn>true</alwaysOn>
        <updateRate>0.0</updateRate>
        <cameraName>head_camera</cameraName>
        <imageTopicName>rgb/image_raw</imageTopicName>
        <cameraInfoTopicName>rgb/camera_info</cameraInfoTopicName>
        <depthImageTopicName>depth/image_raw</depthImageTopicName>
        <depthImageInfoTopicName>depth/camera_info</depthImageInfoTopicName>
        <pointCloudTopicName>depth/points</pointCloudTopicName>
        <frameName>Head_camera_link_optical</frameName>
        <pointCloudCutoff>0.05</pointCloudCutoff>
        <pointCloudCutoffMax>10.0</pointCloudCutoffMax>
        <distortion_k1>0</distortion_k1>
        <distortion_k2>0</distortion_k2>
        <distortion_k3>0</distortion_k3>
        <distortion_t1>0</distortion_t1>
        <distortion_t2>0</distortion_t2>
        <CxPrime>0</CxPrime>
        <Cx>0</Cx>
        <Cy>0</Cy>
        <focalLength>0</focalLength>
        <hackBaseline>0</hackBaseline>
        <robotNamespace>/dual_arm</robotNamespace>
      </plugin>
    </sensor>
  </gazebo>

  <!-- L_EE_joint/R_EE_joint는 fixed 조인트라 URDF->SDF 변환 시 부모 링크(L_elbow/R_elbow)로
       lumping(축약)될 수 있다. lumping되면 조인트 자체가 사라져서 force_torque 피드백을 못 얻으므로
       명시적으로 lumping을 막고 조인트 피드백 계산을 켠다. -->
  <gazebo reference="L_EE_joint">
    <disableFixedJointLumping>true</disableFixedJointLumping>
    <provideFeedback>true</provideFeedback>
  </gazebo>

  <gazebo reference="R_EE_joint">
    <disableFixedJointLumping>true</disableFixedJointLumping>
    <provideFeedback>true</provideFeedback>
  </gazebo>

  <!-- gazebo_ros_ft_sensor: L_EE_joint/R_EE_joint에 걸리는 반력을 각각
       /dual_arm/left_ft_sensor, /dual_arm/right_ft_sensor (geometry_msgs/WrenchStamped)로 발행. -->
  <gazebo>
    <plugin name="l_ee_ft_sensor" filename="libgazebo_ros_ft_sensor.so">
      <updateRate>100.0</updateRate>
      <topicName>/dual_arm/left_ft_sensor</topicName>
      <jointName>L_EE_joint</jointName>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin name="r_ee_ft_sensor" filename="libgazebo_ros_ft_sensor.so">
      <updateRate>100.0</updateRate>
      <topicName>/dual_arm/right_ft_sensor</topicName>
      <jointName>R_EE_joint</jointName>
    </plugin>
  </gazebo>

