  <link
    name="L_EE">
    <inertial>
      <origin
        xyz="0 0 -0.003514"
        rpy="0 0 0" />
      <mass
        value="0.15" />
      <inertia
        ixx="5.5E-05"
        ixy="0"
        ixz="0"
        iyy="5.5E-05"
        iyz="0"
        izz="6.4E-05" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://dual_arm/meshes/L_EE.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.298039215686275 0.298039215686275 0.298039215686275 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://dual_arm/meshes/L_EE.STL" />
      </geometry>
    </collision>
    <!-- 파지 안정성 보강용 평면 접촉 패드. L_EE.STL은 실측(메시 직접 파싱) 결과 약 6.5x6.5x5.4cm의
         거의 구형(반경 ~3.25cm)이라 박스 평면과 사실상 점 접촉만 생겨 이송 중 자세가 흔들리기 쉽다.
         2026-07-13 admittance 검증(F/T 로그) 중 좌/우 힘이 크게 비대칭(예: 같은 tick에 R이 -27N인데
         L은 +7.5N)으로 나타나 물체가 회전하며 낙하하는 게 확인됐고, fk_debug(실제 SolveIK_Position/
         grasp_offset=0.040/STANDOFF_Y=0.15 그대로 재현)로 다시 재보니 L_EE 로컬 Y축이 스퀴즈
         방향(월드 Y축)과 dot=0.757(약 40.8° 어긋남) - 이전 주석의 dot~0.77(grasp_offset=0.043 기준)
         수치는 grasp_offset이 0.040으로 바뀌면서 이미 stale이었다. 패드가 로컬 Y로 고정돼 있어
         면 접촉이 아니라 모서리 접촉에 가까웠던 것으로 보고, rpy를 EE 로컬 프레임에서 "월드 Y가
         가리키는 실제 방향"(target_local_dir = R_EE^T * worldY)으로 패드 법선이 향하도록 보정한다
         (계산: fk_debug.cpp, 일회성 도구, 커밋 안 함). 위치(xyz)는 그대로 두고 방향만 보정 -
         정확한 돌출거리 재튜닝(전체 손 형상 재설계, P2)은 이후 과제로 보류. -->
    <collision name="L_EE_grip_pad_collision">
      <origin
        xyz="0 -0.0375 -0.005"
        rpy="0.699086 0.041596 -0.114007" />
      <geometry>
        <box size="0.04 0.01 0.04" />
      </geometry>
    </collision>
    <!-- L자형 턱(lip): 패드는 마찰(μN)에만 의존하므로 접촉 예산 자체는 늘려주지 않는다. 물체
         아래 모서리를 기하학적으로 받칠 수 있도록 패드 아래쪽에 1cm 턱을 추가한다. 패드와 동일한
         보정 rpy를 적용해 패드-턱의 상대 배치(로컬 -X 아래, 로컬 -Y 바깥쪽 1cm 더 뻗음)를 유지한다 -
         위 패드 주석의 fk_debug 보정과 동일 근거. -->
    <collision name="L_EE_grip_lip_collision">
      <origin
        xyz="-0.025 -0.0475 -0.005"
        rpy="0.699086 0.041596 -0.114007" />
      <geometry>
        <box size="0.01 0.01 0.04" />
      </geometry>
    </collision>
  </link>
