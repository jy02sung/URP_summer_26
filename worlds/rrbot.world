<?xml version="1.0" ?>
<sdf version="1.4">
  <!-- We use a custom world for the rrbot so that the camera angle is launched correctly -->

  <world name="default">
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Global light source -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- 테이블 두 개(pick_table/place_table) 완전 제거함. 반복적으로 팔이 테이블에 걸리는 문제 때문에
         사용자 요청으로 삭제 - 실측 진단(물리엔진 접촉 모니터링)으로는 테이블 충돌 자체는 0건이었고
         실제 원인은 ArUco 검출오차(~3cm) > 파지 스퀴즈 마진(0.5mm)이었지만, 테이블이라는 장애물 자체를
         없애서 그 문제의 여파(물체가 테이블 밖으로 떨어짐)를 원천 차단하는 방향으로 처리함.
         물체/마커 높이는 기존 테이블 상판 높이(z=1.15)를 그대로 유지 - main.cpp의 SAFE_Z=1.50,
         파지 접근 좌표 등 기존에 이 높이 기준으로 다 캘리브레이션되어 있어서 그대로 재사용 가능.

         aruco_box_26은 이제 model.sdf에서 static=false(동역학 물체)다. 받침이 전혀 없으면 스캔/접근
         구간 동안 중력으로 바로 낙하하므로, pick 지점(고정 좌표) 바로 아래에만 작은 pick_pedestal을
         둬서 파지 전까지만 떠받친다 - 예전 테이블처럼 팔 이동 경로 전체를 가로지르는 큰 판이 아니라
         물체 발판 크기(0.17x0.17m)라 팔 충돌 재발 우려가 적다.
         파지~내려놓기 구간은 main.cpp의 임피던스 제어(가상 스프링-댐퍼 + F/T 센서)가 양팔 스퀴즈
         마찰(grasp_offset, mu=1.2)만으로 물체를 들어 옮긴다 - 더 이상 /gazebo/set_model_state로
         pose를 강제 갱신하는 kinematic attach는 쓰지 않는다.
         place 지점(transport_pt)은 실행마다 임의 좌표라 고정 받침대를 둘 수 없다 - 내려놓기 후 손을
         벌리는 순간 그 자리에 받쳐줄 게 없으면 바닥(ground_plane)까지 낙하한다. 특정 위치에 고정해서
         쓰게 되면 그때 pick_pedestal과 동일한 방식으로 place_pedestal을 추가하면 된다. -->

    <!-- Graspable pick object: 15x15x15cm box with a 5cm ArUco id=26 marker facing the head
         camera. dynamic(model.sdf) - held by real friction/impedance grasp, not kinematic attach.
         2026-07-18 (2차 수정): 최초 시도(pick -65deg/place +65deg, 대칭 130deg)는 waist
         92.6deg를 얻었지만 Stage 3 headless 검증 중 발견 - main.cpp의 HEAD_SCAN_YAW/PITCH가
         고정 단일 스캔 자세(yaw=0deg)라 카메라 시야(horizontal_fov 60deg, 약 +-30deg)를 벗어난
         물체는 애초에 ArUco로 못 찾는다(제어 로직은 절대 수정하지 않기로 함). pick을 카메라
         시야 경계(-29deg, 기존 원본 위치 -18.4deg보다 조금 더 밀어붙인 값)에 묶어두면 waist
         범위(+-0.87rad=+-49.85deg)가 place 쪽에서 하드리밋에 막혀 스윙이 61~68deg 선에서
         꺾인다는 것도 pinocchio 스캔(반지름/각도 여러 조합)으로 재확인함 - 90deg는 이 제약 하에서
         물리적으로 불가능. 사용자에게 확인 후 "68deg로 타협, 제어 로직 무수정" 선택받아 pick을
         (0.4146,-0.2298)(반지름 0.474, -29deg, 카메라 시야 경계)로, place를 (0.0823,0.4668)
         (반지름 0.474, +80deg, waist 하드리밋 +49.85deg 직전)으로 재배치 - 실측 waist swing
         68.8deg, IK 수렴 잔차 최대 8.4cm(place 도달 지점에서 최대, 안전 버퍼에 반영). Z는
         1.225->1.275로 유지(신규 fan table 상판 z=1.20 + 박스 반높이 0.075). -->
    <include>
      <uri>model://aruco_box_26</uri>
      <name>aruco_box_26</name>
      <pose>0.4146 -0.2298 1.275 0 0 0</pose>
    </include>

    <!-- 2026-07-18: 구 pick_pedestal(0.45,-0.15, 상판 z=1.15, 17x17cm)은 새 pick 좌표
         (0.4146,-0.2298)와 반지름은 같고 각도만 10.6deg 차이라 XY상 거의 완전히 겹친다(더 이상
         "안 겹치니 그냥 둔다"고 할 수 없는 수준) - 게다가 높이도 다르다(1.15 vs 신규 1.20)라 두
         정적 솔리드가 서로 침투(z-fighting)하는 시각적 문제가 생겨 제거함. pick 지지는 아래
         transport_fan_table의 pick_pad가 전담. -->

    <!-- ============================================================================
         transport_fan_table: 허리(Waist_joint)가 크게 회전하는 모습을 보여주기 위한 시각화용
         탁자. pick=(0.4146,-0.2298, -29deg, 카메라 스캔 시야 경계), place=(0.0823,0.4668,
         +80deg, waist 하드리밋 직전) - 둘 다 torso 축 기준 반지름 0.474m. main.cpp의
         SolveIK_Position(DLS+null-space, lambda=0.1)을 pinocchio로 그대로 재현해 스캔한 결과
         Waist_joint가 실측 약 68.8deg 회전(관절 하드리밋 +-0.87rad=99.7deg 중 place 쪽에서
         +0.87rad에 정확히 도달 - 이게 스윙의 물리적 상한, 더 큰 스윙은 이 pick 위치에서는
         불가능함을 여러 반지름/각도 조합으로 확인). main.cpp/urdf 등 제어 로직은 전혀 건드리지
         않음 - 순수 world 파일의 시각적 모델링.

         안전 마진 산정: 이 스캔에서 IK 수렴 잔차가 최대 ~8.4cm까지 발생함을 확인(반복횟수를
         늘려도 잔차 불변 - dual_arm_function.cpp 자체 주석의 "damped pseudo-inverse가 완전한
         직교투영이 아니라 태스크 방향으로 샌다"는 현상과 일치, waist가 하드리밋에 눌린 채로
         목표에 못 미치는 구성이라 1차 시도(6cm)보다 더 큼). 기존 ArUco 인식오차 버퍼(3~5cm,
         place 지점은 ArUco 미사용이라 무관)보다 이 IK 잔차가 더 커서, 상판 안쪽 경계를 반지름
         0.354m로 제한(실제 스윙 반경 0.474m 대비 12cm 여유) - 본체를 스윙 반경보다 상당히
         안쪽으로 당겨두고, pick/place 지점에만 지름 26cm 원형 받침(pad)을 반지름 0.474 지점까지
         내밀어 물체를 지지한다(본체 바깥쪽 경계 0.354와 pad 안쪽 경계 0.344가 1cm 겹쳐 하나로
         이어짐 - 단일 상판 요건 충족).

         주의: 이 계산은 로봇의 유휴(idle) 자세를 정확히 몰라 근사값(q_pref 자세)으로 대체한
         근사 모델이라 완전히 정밀하지 않다 - Stage 3 headless Gazebo 충돌 체크와 사용자의
         GUI 실행 확인이 최종 검증. ============================================================ -->
    <model name="transport_fan_table">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="fan_seg_0_collision"><pose>0.2448 -0.1296 1.1600 0 0 -0.4868</pose><geometry><box><size>0.0456 0.1540 0.08</size></box></geometry></collision>
        <visual name="fan_seg_0_visual"><pose>0.2448 -0.1296 1.1600 0 0 -0.4868</pose><geometry><box><size>0.0456 0.1540 0.08</size></box></geometry><material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual>
        <collision name="fan_seg_1_collision"><pose>0.2608 -0.0933 1.1600 0 0 -0.3435</pose><geometry><box><size>0.0456 0.1540 0.08</size></box></geometry></collision>
        <visual name="fan_seg_1_visual"><pose>0.2608 -0.0933 1.1600 0 0 -0.3435</pose><geometry><box><size>0.0456 0.1540 0.08</size></box></geometry><material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual>
        <collision name="fan_seg_2_collision"><pose>0.2715 -0.0551 1.1600 0 0 -0.2001</pose><geometry><box><size>0.0456 0.1540 0.08</size></box></geometry></collision>
        <visual name="fan_seg_2_visual"><pose>0.2715 -0.0551 1.1600 0 0 -0.2001</pose><geometry><box><size>0.0456 0.1540 0.08</size></box></geometry><material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual>
        <collision name="fan_seg_3_collision"><pose>0.2766 -0.0157 1.1600 0 0 -0.0567</pose><geometry><box><size>0.0456 0.1540 0.08</size></box></geometry></collision>
        <visual name="fan_seg_3_visual"><pose>0.2766 -0.0157 1.1600 0 0 -0.0567</pose><geometry><box><size>0.0456 0.1540 0.08</size></box></geometry><material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual>
        <collision name="fan_seg_4_collision"><pose>0.2760 0.0240 1.1600 0 0 0.0866</pose><geometry><box><size>0.0456 0.1540 0.08</size></box></geometry></collision>
        <visual name="fan_seg_4_visual"><pose>0.2760 0.0240 1.1600 0 0 0.0866</pose><geometry><box><size>0.0456 0.1540 0.08</size></box></geometry><material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual>
        <collision name="fan_seg_5_collision"><pose>0.2697 0.0632 1.1600 0 0 0.2300</pose><geometry><box><size>0.0456 0.1540 0.08</size></box></geometry></collision>
        <visual name="fan_seg_5_visual"><pose>0.2697 0.0632 1.1600 0 0 0.2300</pose><geometry><box><size>0.0456 0.1540 0.08</size></box></geometry><material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual>
        <collision name="fan_seg_6_collision"><pose>0.2579 0.1010 1.1600 0 0 0.3734</pose><geometry><box><size>0.0456 0.1540 0.08</size></box></geometry></collision>
        <visual name="fan_seg_6_visual"><pose>0.2579 0.1010 1.1600 0 0 0.3734</pose><geometry><box><size>0.0456 0.1540 0.08</size></box></geometry><material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual>
        <collision name="fan_seg_7_collision"><pose>0.2408 0.1369 1.1600 0 0 0.5167</pose><geometry><box><size>0.0456 0.1540 0.08</size></box></geometry></collision>
        <visual name="fan_seg_7_visual"><pose>0.2408 0.1369 1.1600 0 0 0.5167</pose><geometry><box><size>0.0456 0.1540 0.08</size></box></geometry><material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual>
        <collision name="fan_seg_8_collision"><pose>0.2188 0.1699 1.1600 0 0 0.6601</pose><geometry><box><size>0.0456 0.1540 0.08</size></box></geometry></collision>
        <visual name="fan_seg_8_visual"><pose>0.2188 0.1699 1.1600 0 0 0.6601</pose><geometry><box><size>0.0456 0.1540 0.08</size></box></geometry><material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual>
        <collision name="fan_seg_9_collision"><pose>0.1923 0.1994 1.1600 0 0 0.8035</pose><geometry><box><size>0.0456 0.1540 0.08</size></box></geometry></collision>
        <visual name="fan_seg_9_visual"><pose>0.1923 0.1994 1.1600 0 0 0.8035</pose><geometry><box><size>0.0456 0.1540 0.08</size></box></geometry><material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual>
        <collision name="fan_seg_10_collision"><pose>0.1618 0.2248 1.1600 0 0 0.9468</pose><geometry><box><size>0.0456 0.1540 0.08</size></box></geometry></collision>
        <visual name="fan_seg_10_visual"><pose>0.1618 0.2248 1.1600 0 0 0.9468</pose><geometry><box><size>0.0456 0.1540 0.08</size></box></geometry><material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual>
        <collision name="fan_seg_11_collision"><pose>0.1281 0.2456 1.1600 0 0 1.0902</pose><geometry><box><size>0.0456 0.1540 0.08</size></box></geometry></collision>
        <visual name="fan_seg_11_visual"><pose>0.1281 0.2456 1.1600 0 0 1.0902</pose><geometry><box><size>0.0456 0.1540 0.08</size></box></geometry><material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual>
        <collision name="fan_seg_12_collision"><pose>0.0917 0.2614 1.1600 0 0 1.2336</pose><geometry><box><size>0.0456 0.1540 0.08</size></box></geometry></collision>
        <visual name="fan_seg_12_visual"><pose>0.0917 0.2614 1.1600 0 0 1.2336</pose><geometry><box><size>0.0456 0.1540 0.08</size></box></geometry><material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual>
        <collision name="fan_seg_13_collision"><pose>0.0534 0.2718 1.1600 0 0 1.3769</pose><geometry><box><size>0.0456 0.1540 0.08</size></box></geometry></collision>
        <visual name="fan_seg_13_visual"><pose>0.0534 0.2718 1.1600 0 0 1.3769</pose><geometry><box><size>0.0456 0.1540 0.08</size></box></geometry><material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual>
        <collision name="pick_pad_collision"><pose>0.4146 -0.2298 1.1600 0 0 0</pose><geometry><cylinder><radius>0.13</radius><length>0.08</length></cylinder></geometry></collision>
        <visual name="pick_pad_visual"><pose>0.4146 -0.2298 1.1600 0 0 0</pose><geometry><cylinder><radius>0.13</radius><length>0.08</length></cylinder></geometry><material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual>
        <collision name="place_pad_collision"><pose>0.0823 0.4668 1.1600 0 0 0</pose><geometry><cylinder><radius>0.13</radius><length>0.08</length></cylinder></geometry></collision>
        <visual name="place_pad_visual"><pose>0.0823 0.4668 1.1600 0 0 0</pose><geometry><cylinder><radius>0.13</radius><length>0.08</length></cylinder></geometry><material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Focus camera on tall pendulum -->
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>4.927360 -4.376610 3.740080 0.000000 0.275643 2.356190</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

  </world>
</sdf>
