<?xml version="1.0" ?>
<sdf version="1.4">
  <!-- We use a custom world for the rrbot so that the camera angle is launched correctly -->

  <world name="default">
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Global light source -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Focus camera on tall pendulum -->
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>4.927360 -4.376610 3.740080 0.000000 0.275643 2.356190</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

  <model name="table_front">
    <static>true</static>
    <pose>0.5 0 0.975 0 0 0</pose>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>0.3 0.9 0.05</size></box></geometry>
        <surface>
          <contact>
              <ode>
                  <kp>10000000</kp>
                  <kd>1000</kd>
              </ode>
          </contact>
      </surface>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.3 0.9 0.05</size></box></geometry>
        <material><ambient>0.6 0.4 0.2 1</ambient></material>
      </visual>
    </link>
  </model>

  <model name="table_left">
    <static>true</static>
    <pose>0 0.5 0.975 0 0 1.5708</pose>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>0.3 0.9 0.05</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.3 0.9 0.05</size></box></geometry>
        <material><ambient>0.6 0.4 0.2 1</ambient></material>
      </visual>
    </link>
  </model>

  <model name="table_right">
    <static>true</static>
    <pose>0 -0.5 0.975 0 0 1.5708</pose>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>0.3 0.9 0.05</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.3 0.9 0.05</size></box></geometry>
        <material><ambient>0.6 0.4 0.2 1</ambient></material>
      </visual>
    </link>
  </model>

  <model name="aruco_cube_target">
      <static>false</static>
      <pose>0.5 0 1.15 0 0 0</pose>
      <link name="link">
          <inertial>
              <mass>5</mass>
              <inertia>
                  <ixx>0.075</ixx><ixy>0</ixy><ixz>0</ixz>
                  <iyy>0.075</iyy><iyz>0</iyz>
                  <izz>0.075</izz>
              </inertia>
          </inertial>
          <collision name="collision">
              <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
              <surface>
                  <contact>
                      <ode>
                          <kp>30000</kp>
                          <kd>300</kd>
                          <max_vel>0.05</max_vel>
                          <min_depth>0.0001</min_depth>
                      </ode>
                  </contact>
                  <friction>
                      <ode>
                          <mu>1.0</mu>
                          <mu2>1.0</mu2>
                      </ode>
                  </friction>
              </surface>
          </collision>
          <visual name="visual">
              <geometry>
                  <mesh>
                      <uri>model://aruco_cube/meshes/aruco_cube_5cm.dae</uri>
                      <scale>6 6 6</scale>
                  </mesh>
              </geometry>
          </visual>
      </link>
  </model>

  </world>
</sdf>
