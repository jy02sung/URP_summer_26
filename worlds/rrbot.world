<?xml version="1.0" ?>
<sdf version="1.4">
  <!-- We use a custom world for the rrbot so that the camera angle is launched correctly -->

  <world name="default">
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Global light source -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- 테이블 두 개(pick_table/place_table) 완전 제거함. 반복적으로 팔이 테이블에 걸리는 문제 때문에
         사용자 요청으로 삭제 - 실측 진단(물리엔진 접촉 모니터링)으로는 테이블 충돌 자체는 0건이었고
         실제 원인은 ArUco 검출오차(~3cm) > 파지 스퀴즈 마진(0.5mm)이었지만, 테이블이라는 장애물 자체를
         없애서 그 문제의 여파(물체가 테이블 밖으로 떨어짐)를 원천 차단하는 방향으로 처리함.
         물체/마커 높이는 기존 테이블 상판 높이(z=1.15)를 그대로 유지 - main.cpp의 SAFE_Z=1.50,
         파지 접근 좌표 등 기존에 이 높이 기준으로 다 캘리브레이션되어 있어서 그대로 재사용 가능.

         aruco_box_26은 이제 model.sdf에서 static=false(동역학 물체)다. 받침이 전혀 없으면 스캔/접근
         구간 동안 중력으로 바로 낙하하므로, pick 지점(고정 좌표) 바로 아래에만 작은 pick_pedestal을
         둬서 파지 전까지만 떠받친다 - 예전 테이블처럼 팔 이동 경로 전체를 가로지르는 큰 판이 아니라
         물체 발판 크기(0.17x0.17m)라 팔 충돌 재발 우려가 적다.
         파지~내려놓기 구간은 main.cpp의 임피던스 제어(가상 스프링-댐퍼 + F/T 센서)가 양팔 스퀴즈
         마찰(grasp_offset, mu=1.2)만으로 물체를 들어 옮긴다 - 더 이상 /gazebo/set_model_state로
         pose를 강제 갱신하는 kinematic attach는 쓰지 않는다.
         place 지점(transport_pt)은 실행마다 임의 좌표라 고정 받침대를 둘 수 없다 - 내려놓기 후 손을
         벌리는 순간 그 자리에 받쳐줄 게 없으면 바닥(ground_plane)까지 낙하한다. 특정 위치에 고정해서
         쓰게 되면 그때 pick_pedestal과 동일한 방식으로 place_pedestal을 추가하면 된다. -->

    <!-- Graspable pick object: 15x15x15cm box with a 5cm ArUco id=26 marker facing the head
         camera. dynamic(model.sdf) - held by real friction/impedance grasp, not kinematic attach.
         2026-07-18: pick XY moved to (0.2113,-0.4532) (radius 0.50, angle -65deg from torso axis)
         so that, paired with the new transport_fan_table place target (0.2113,+0.4532, +65deg),
         whole-body IK is forced to recruit ~93deg of Waist_joint swing (joint limit is +-0.87rad
         = +-49.85deg = 99.7deg total, so this leaves ~7deg of margin, not saturated at the hard
         limit). Z raised from 1.225 to 1.275 = new table top(1.20) + half box height(0.075), so
         the box still rests exactly flush on the new table surface (matches the old
         pick_pedestal(1.15 top)+1.225 relationship 1:1, just retargeted to 1.20/1.275). -->
    <include>
      <uri>model://aruco_box_26</uri>
      <name>aruco_box_26</name>
      <pose>0.2113 -0.4532 1.275 0 0 0</pose>
    </include>

    <!-- pick 지점 전용 소형 받침대: 물체 발판(15x15cm)보다 살짝 큰 17x17cm, 상판 z=1.15(기존 테이블
         높이와 동일). 파지 전(LOCATE+APPROACH) 동안만 물체를 떠받치는 용도 - 팔은 물체 바로 위/옆으로만
         접근하므로 이 작은 받침대와 충돌할 일이 없다. -->
    <model name="pick_pedestal">
      <static>true</static>
      <pose>0.45 -0.15 1.10 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.17 0.17 0.10</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.17 0.17 0.10</size></box>
          </geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- 2026-07-18: 위 pick_pedestal은 새 pick 좌표(0.2113,-0.4532)와 더 이상 겹치지 않는다 - 사용자
         요청으로 일단 그대로 남겨둠(제거하지 않음). 실제 pick/place 지지는 아래 transport_fan_table이
         전담한다. -->

    <!-- ============================================================================
         transport_fan_table: 허리(Waist_joint)가 크게 회전하는 모습을 보여주기 위한 시각화용
         탁자. pick=(0.2113,-0.4532), place=(0.2113,+0.4532) (torso 축 기준 반지름 0.50m,
         각각 -65/+65deg, 총 130deg 배치) - pinocchio로 main.cpp의 SolveIK_Position(DLS+
         null-space, lambda=0.1)을 그대로 재현해 스캔한 결과 Waist_joint가 실측 약 92.6deg
         회전한다(관절 한계 +-0.87rad=99.7deg total 이내, 하드리밋에서 ~7deg 여유). main.cpp/
         urdf 등 제어 로직은 전혀 건드리지 않음 - 순수 world 파일의 시각적 모델링.

         안전 마진 산정: 이 스윙 폭에서 SolveIK_Position을 pinocchio로 재현해보니 수렴 잔차가
         최대 ~6cm까지 발생함을 확인(300~5000 iteration 모두 동일값에 수렴 - 반복횟수 부족이
         아니라 damped pseudo-inverse가 완전한 직교투영이 아니어서 태스크 방향으로 새는 것이
         원인이라는 dual_arm_function.cpp 자체 주석과 일치. 기존 소폭 스윙에서 이미 알려진
         현상이었으나 이번처럼 큰 스윙에서는 그 잔차가 더 커짐). 기존에 합의한 ArUco 인식오차
         버퍼(3~5cm, place 지점은 ArUco를 안 쓰므로 무관)에 더해, 이 IK 잔차까지 감안해 상판
         안쪽 경계를 반지름 0.42m로 제한(실제 스윙 반경 0.50m 대비 8cm 여유 + pick/place 지점
         자체는 원래 그 높이(1.275, 상판보다 7.5cm 위)에서 접근하도록 설계돼 있어 별도 안전) -
         본체를 일부러 안쪽으로 당겨 좁혀두고, pick/place 지점에만 지름 26cm 원형 받침(pad)을
         내밀어 물체를 지지한다(반지름 0.50 지점, 본체 바깥쪽 경계 0.42와 5cm 겹쳐 하나로
         이어짐 - 단일 상판 요건 충족).

         주의: 이 계산은 로봇의 유휴(idle) 자세를 정확히 몰라 근사값(q_pref 자세)으로 대체한
         근사 모델이라 완전히 정밀하지 않다 - Stage 3 headless Gazebo 충돌 체크와 사용자의
         GUI 실행 확인이 최종 검증. ============================================================ -->
    <model name="transport_fan_table">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="fan_seg_0_collision"><pose>0.1186 -0.2864 1.1600 0 0 -1.1781</pose><geometry><box><size>0.0559 0.2200 0.08</size></box></geometry></collision>
        <visual name="fan_seg_0_visual"><pose>0.1186 -0.2864 1.1600 0 0 -1.1781</pose><geometry><box><size>0.0559 0.2200 0.08</size></box></geometry><material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual>
        <collision name="fan_seg_1_collision"><pose>0.1620 -0.2643 1.1600 0 0 -1.0210</pose><geometry><box><size>0.0559 0.2200 0.08</size></box></geometry></collision>
        <visual name="fan_seg_1_visual"><pose>0.1620 -0.2643 1.1600 0 0 -1.0210</pose><geometry><box><size>0.0559 0.2200 0.08</size></box></geometry><material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual>
        <collision name="fan_seg_2_collision"><pose>0.2013 -0.2357 1.1600 0 0 -0.8639</pose><geometry><box><size>0.0559 0.2200 0.08</size></box></geometry></collision>
        <visual name="fan_seg_2_visual"><pose>0.2013 -0.2357 1.1600 0 0 -0.8639</pose><geometry><box><size>0.0559 0.2200 0.08</size></box></geometry><material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual>
        <collision name="fan_seg_3_collision"><pose>0.2357 -0.2013 1.1600 0 0 -0.7069</pose><geometry><box><size>0.0559 0.2200 0.08</size></box></geometry></collision>
        <visual name="fan_seg_3_visual"><pose>0.2357 -0.2013 1.1600 0 0 -0.7069</pose><geometry><box><size>0.0559 0.2200 0.08</size></box></geometry><material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual>
        <collision name="fan_seg_4_collision"><pose>0.2643 -0.1620 1.1600 0 0 -0.5498</pose><geometry><box><size>0.0559 0.2200 0.08</size></box></geometry></collision>
        <visual name="fan_seg_4_visual"><pose>0.2643 -0.1620 1.1600 0 0 -0.5498</pose><geometry><box><size>0.0559 0.2200 0.08</size></box></geometry><material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual>
        <collision name="fan_seg_5_collision"><pose>0.2864 -0.1186 1.1600 0 0 -0.3927</pose><geometry><box><size>0.0559 0.2200 0.08</size></box></geometry></collision>
        <visual name="fan_seg_5_visual"><pose>0.2864 -0.1186 1.1600 0 0 -0.3927</pose><geometry><box><size>0.0559 0.2200 0.08</size></box></geometry><material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual>
        <collision name="fan_seg_6_collision"><pose>0.3014 -0.0724 1.1600 0 0 -0.2356</pose><geometry><box><size>0.0559 0.2200 0.08</size></box></geometry></collision>
        <visual name="fan_seg_6_visual"><pose>0.3014 -0.0724 1.1600 0 0 -0.2356</pose><geometry><box><size>0.0559 0.2200 0.08</size></box></geometry><material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual>
        <collision name="fan_seg_7_collision"><pose>0.3090 -0.0243 1.1600 0 0 -0.0785</pose><geometry><box><size>0.0559 0.2200 0.08</size></box></geometry></collision>
        <visual name="fan_seg_7_visual"><pose>0.3090 -0.0243 1.1600 0 0 -0.0785</pose><geometry><box><size>0.0559 0.2200 0.08</size></box></geometry><material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual>
        <collision name="fan_seg_8_collision"><pose>0.3090 0.0243 1.1600 0 0 0.0785</pose><geometry><box><size>0.0559 0.2200 0.08</size></box></geometry></collision>
        <visual name="fan_seg_8_visual"><pose>0.3090 0.0243 1.1600 0 0 0.0785</pose><geometry><box><size>0.0559 0.2200 0.08</size></box></geometry><material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual>
        <collision name="fan_seg_9_collision"><pose>0.3014 0.0724 1.1600 0 0 0.2356</pose><geometry><box><size>0.0559 0.2200 0.08</size></box></geometry></collision>
        <visual name="fan_seg_9_visual"><pose>0.3014 0.0724 1.1600 0 0 0.2356</pose><geometry><box><size>0.0559 0.2200 0.08</size></box></geometry><material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual>
        <collision name="fan_seg_10_collision"><pose>0.2864 0.1186 1.1600 0 0 0.3927</pose><geometry><box><size>0.0559 0.2200 0.08</size></box></geometry></collision>
        <visual name="fan_seg_10_visual"><pose>0.2864 0.1186 1.1600 0 0 0.3927</pose><geometry><box><size>0.0559 0.2200 0.08</size></box></geometry><material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual>
        <collision name="fan_seg_11_collision"><pose>0.2643 0.1620 1.1600 0 0 0.5498</pose><geometry><box><size>0.0559 0.2200 0.08</size></box></geometry></collision>
        <visual name="fan_seg_11_visual"><pose>0.2643 0.1620 1.1600 0 0 0.5498</pose><geometry><box><size>0.0559 0.2200 0.08</size></box></geometry><material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual>
        <collision name="fan_seg_12_collision"><pose>0.2357 0.2013 1.1600 0 0 0.7069</pose><geometry><box><size>0.0559 0.2200 0.08</size></box></geometry></collision>
        <visual name="fan_seg_12_visual"><pose>0.2357 0.2013 1.1600 0 0 0.7069</pose><geometry><box><size>0.0559 0.2200 0.08</size></box></geometry><material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual>
        <collision name="fan_seg_13_collision"><pose>0.2013 0.2357 1.1600 0 0 0.8639</pose><geometry><box><size>0.0559 0.2200 0.08</size></box></geometry></collision>
        <visual name="fan_seg_13_visual"><pose>0.2013 0.2357 1.1600 0 0 0.8639</pose><geometry><box><size>0.0559 0.2200 0.08</size></box></geometry><material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual>
        <collision name="fan_seg_14_collision"><pose>0.1620 0.2643 1.1600 0 0 1.0210</pose><geometry><box><size>0.0559 0.2200 0.08</size></box></geometry></collision>
        <visual name="fan_seg_14_visual"><pose>0.1620 0.2643 1.1600 0 0 1.0210</pose><geometry><box><size>0.0559 0.2200 0.08</size></box></geometry><material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual>
        <collision name="fan_seg_15_collision"><pose>0.1186 0.2864 1.1600 0 0 1.1781</pose><geometry><box><size>0.0559 0.2200 0.08</size></box></geometry></collision>
        <visual name="fan_seg_15_visual"><pose>0.1186 0.2864 1.1600 0 0 1.1781</pose><geometry><box><size>0.0559 0.2200 0.08</size></box></geometry><material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual>
        <collision name="pick_pad_collision"><pose>0.2113 -0.4532 1.1600 0 0 0</pose><geometry><cylinder><radius>0.13</radius><length>0.08</length></cylinder></geometry></collision>
        <visual name="pick_pad_visual"><pose>0.2113 -0.4532 1.1600 0 0 0</pose><geometry><cylinder><radius>0.13</radius><length>0.08</length></cylinder></geometry><material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual>
        <collision name="place_pad_collision"><pose>0.2113 0.4532 1.1600 0 0 0</pose><geometry><cylinder><radius>0.13</radius><length>0.08</length></cylinder></geometry></collision>
        <visual name="place_pad_visual"><pose>0.2113 0.4532 1.1600 0 0 0</pose><geometry><cylinder><radius>0.13</radius><length>0.08</length></cylinder></geometry><material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Focus camera on tall pendulum -->
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>4.927360 -4.376610 3.740080 0.000000 0.275643 2.356190</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

  </world>
</sdf>
