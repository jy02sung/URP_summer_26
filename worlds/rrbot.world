<?xml version="1.0" ?>
<sdf version="1.4">
  <!-- We use a custom world for the rrbot so that the camera angle is launched correctly -->

  <world name="default">
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Global light source -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- 테이블 두 개(pick_table/place_table) 완전 제거함. 반복적으로 팔이 테이블에 걸리는 문제 때문에
         사용자 요청으로 삭제 - 실측 진단(물리엔진 접촉 모니터링)으로는 테이블 충돌 자체는 0건이었고
         실제 원인은 ArUco 검출오차(~3cm) > 파지 스퀴즈 마진(0.5mm)이었지만, 테이블이라는 장애물 자체를
         없애서 그 문제의 여파(물체가 테이블 밖으로 떨어짐)를 원천 차단하는 방향으로 처리함.
         물체/마커 높이는 기존 테이블 상판 높이(z=1.15)를 그대로 유지 - main.cpp의 SAFE_Z=1.50,
         파지 접근 좌표 등 기존에 이 높이 기준으로 다 캘리브레이션되어 있어서 그대로 재사용 가능.

         aruco_box_26은 이제 model.sdf에서 static=false(동역학 물체)다. 받침이 전혀 없으면 스캔/접근
         구간 동안 중력으로 바로 낙하하므로, pick 지점(고정 좌표) 바로 아래에만 작은 pick_pedestal을
         둬서 파지 전까지만 떠받친다 - 예전 테이블처럼 팔 이동 경로 전체를 가로지르는 큰 판이 아니라
         물체 발판 크기(0.17x0.17m)라 팔 충돌 재발 우려가 적다.
         파지~내려놓기 구간은 main.cpp의 임피던스 제어(가상 스프링-댐퍼 + F/T 센서)가 양팔 스퀴즈
         마찰(grasp_offset, mu=1.2)만으로 물체를 들어 옮긴다 - 더 이상 /gazebo/set_model_state로
         pose를 강제 갱신하는 kinematic attach는 쓰지 않는다.
         place 지점(transport_pt)은 실행마다 임의 좌표라 고정 받침대를 둘 수 없다 - 내려놓기 후 손을
         벌리는 순간 그 자리에 받쳐줄 게 없으면 바닥(ground_plane)까지 낙하한다. 특정 위치에 고정해서
         쓰게 되면 그때 pick_pedestal과 동일한 방식으로 place_pedestal을 추가하면 된다. -->

    <!-- Graspable pick object: 15x15x15cm box with a 5cm ArUco id=26 marker facing the head
         camera. dynamic(model.sdf) - held by real friction/impedance grasp, not kinematic attach.
         2026-07-18 (3차 수정): 2차 시도(pick -29deg, 카메라 시야 경계)를 headless Gazebo에서
         실제 dual_arm_command로 돌려봤더니 그마저도 ArUco가 못 찾음을 확인 - main.cpp의 스캔은
         실패 시 재시도 없이 즉시 PHASE_APPROACH로 리셋되는 1회성 로직이라(runScanStep의
         SCAN_CHECK 분기), 이론상 FOV 여유(±30deg)가 있어 보여도 실제로는 -29deg가 안 됨.
         카메라 시야 경계에서 "이 정도면 되겠지"로 미세조정하는 건 매번 30초+ 걸리는 실제 Gazebo
         재현이 필요해 위험이 커서, pick 좌표를 원래 검증된 값(0.45,-0.15, -18.4deg)으로 완전히
         되돌림(z도 원래 1.225 그대로, 아무것도 안 바꿈) - 이 좌표는 프로젝트 히스토리 전체에서
         수십 회 반복 검증된 값이라 탐지 실패 위험이 없음. place는 이전과 동일(0.0823,0.4668,
         +80deg, 반지름 0.474m, waist 하드리밋 직전) - 실측 waist swing 61.6deg로 낮아짐
         (68.8deg에서 하락, pick의 waist 기여분이 줄어든 만큼). -->
    <include>
      <uri>model://aruco_box_26</uri>
      <name>aruco_box_26</name>
      <pose>0.45 -0.15 1.225 0 0 0</pose>
    </include>

    <!-- pick 지점 전용 소형 받침대(원본 그대로 복원): 물체 발판(15x15cm)보다 살짝 큰 17x17cm,
         상판 z=1.15. 파지 전(LOCATE+APPROACH) 동안만 물체를 떠받치는 용도 - 팔은 물체 바로
         위/옆으로만 접근하므로 이 작은 받침대와 충돌할 일이 없다(프로젝트 히스토리 전체에서
         검증됨). 새 pick 좌표가 다시 이 자리와 정확히 일치하므로 그대로 복원. -->
    <model name="pick_pedestal">
      <static>true</static>
      <pose>0.45 -0.15 1.10 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.17 0.17 0.10</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.17 0.17 0.10</size></box>
          </geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================================
         transport_fan_table (8차 수정, 2026-07-18): 7차(bd1e36a)는 "벽 조각 하나만 옮기는
         땜빵"이었음 - 사용자가 이를 지적하고 정석대로(회전/센터링/크기) 재설계를 요청함.

         로봇 정면 확인: launch/gazebo.launch의 spawn_model에 -x/-y/-Y 인자가 전혀 없음
         (Waist_joint 등 조인트 각만 지정) -> 로봇은 world 원점(0,0,0), yaw=0으로 스폰됨.
         즉 로봇의 실제 정면은 world +X축이다. 따라서 7차까지 쓰던 "+80deg(place 방향)로
         모델 전체를 돌리는" 방식은애초에 로봇 정면 기준이 아니라 place 좌표 기준의 임의
         회전이었다 - 그래서 입구가 로봇을 향하지 못했던 것.

         해결(회전 트릭 제거): 모델 회전을 0으로 되돌려 로컬 u/v 좌표계를 world X/Y와 그대로
         일치시켰다. ㄷ자 입구가 이제 로봇의 실제 정면(+X, 로봇이 원점에서 바라보는 방향)을
         곧장 향한다.
         1) Y축 중심 정렬: left_arm(y=-0.47)/right_arm(y=+0.47)를 y=0 기준 완전 대칭 배치.
         2) 안쪽 간격: 입구(mouth)는 x=0 부근~0.65, y=-0.36~0.36 구간이 통째로 비어 있어
            로봇이 그 한가운데 서고, 팔을 뻗어도 안쪽 벽면(=팔 패널이 시작되는 x=0.65 이후)에
            닿을 일이 없다(6차 대비 오히려 더 넓어짐: 기존 mouth 깊이 0.43m -> 0.65m).
         3) 바깥쪽 확장(좌표 커버): place 좌표(0.0823, 0.4668)를 world 좌표로 다시 보니 로봇
            중심에서 x로 겨우 8cm 떨어진 지점 - "바깥쪽 테두리"가 아니라 arm 패널의 "안쪽(로봇
            쪽) 경계"가 문제였다(기존 0.12m는 place x=0.0823보다 바깥쪽이라 허공에 뜸). arm
            안쪽 경계를 0.12m -> -0.03m로 당기고, 폭도 0.20m -> 0.22m(중심 y=0.47)로 넓혀서
            물체 풋프린트(15x15cm)가 안쪽 3.7cm/바깥쪽 3.8cm/좌우 4.2cm·4.8cm 여유를 갖고
            패널 위에 완전히 얹히도록 함.

         회전을 없애면서 새로 발견한 문제: 로컬=world가 되니 기존 back_wall의 x범위
         (0.43~0.61)가 pick_pedestal/pick 좌표(0.45,-0.15, footprint x=0.365~0.535)와
         그대로 겹쳐버림(7차까지는 +80deg 회전 덕에 안 겹쳤을 뿐, 실제로는 위험했음). back_wall
         근접단을 0.43->0.65로 밀어내 pick 쪽과 최소 11.5cm 이상 띄우고, arm 바깥쪽 끝도
         0.61->0.65로 맞춰 back_wall과 이어지게 연장했다. 패널 두께/재질/높이(z=1.16 상판,
         floor~1.12 지지벽, Gazebo/Wood)는 그대로 유지.

         arm 스윕 중 실제 충돌 안전마진의 최종 검증은 여전히 사용자가 Gazebo에서 직접 확인하기로
         한 부분이라(place 지점이 패널 "위"에 있다는 기하학적 배치만 여기서 보장) 손대지 않음.
         main.cpp/urdf 등 제어 로직은 이번에도 전혀 건드리지 않음 - 순수 world 파일 시각적
         모델링. 실행 시 반드시 `source /home/jungmin/friend_ws_88pct/devel/setup.bash`를
         먼저 하고 실행할 것(이 컴퓨터의 ~/.bashrc가 다른 워크스페이스(~/catkin_ws)를 자동
         소싱함). ============================================================ -->
    <model name="transport_fan_table">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="back_wall_collision"><pose>0.7400 0.0000 1.1600 0 0 0</pose><geometry><box><size>0.1800 1.1600 0.08</size></box></geometry></collision>
        <visual name="back_wall_visual"><pose>0.7400 0.0000 1.1600 0 0 0</pose><geometry><box><size>0.1800 1.1600 0.08</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual>
        <collision name="back_wall_panel_collision"><pose>0.7400 0.0000 0.5600 0 0 0</pose><geometry><box><size>0.1800 1.1600 1.1200</size></box></geometry></collision>
        <visual name="back_wall_panel_visual"><pose>0.7400 0.0000 0.5600 0 0 0</pose><geometry><box><size>0.1800 1.1600 1.1200</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual>
        <collision name="left_arm_collision"><pose>0.3100 -0.4700 1.1600 0 0 0</pose><geometry><box><size>0.6800 0.2200 0.08</size></box></geometry></collision>
        <visual name="left_arm_visual"><pose>0.3100 -0.4700 1.1600 0 0 0</pose><geometry><box><size>0.6800 0.2200 0.08</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual>
        <collision name="left_arm_panel_collision"><pose>0.3100 -0.4700 0.5600 0 0 0</pose><geometry><box><size>0.6800 0.2200 1.1200</size></box></geometry></collision>
        <visual name="left_arm_panel_visual"><pose>0.3100 -0.4700 0.5600 0 0 0</pose><geometry><box><size>0.6800 0.2200 1.1200</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual>
        <collision name="right_arm_collision"><pose>0.3100 0.4700 1.1600 0 0 0</pose><geometry><box><size>0.6800 0.2200 0.08</size></box></geometry></collision>
        <visual name="right_arm_visual"><pose>0.3100 0.4700 1.1600 0 0 0</pose><geometry><box><size>0.6800 0.2200 0.08</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual>
        <collision name="right_arm_panel_collision"><pose>0.3100 0.4700 0.5600 0 0 0</pose><geometry><box><size>0.6800 0.2200 1.1200</size></box></geometry></collision>
        <visual name="right_arm_panel_visual"><pose>0.3100 0.4700 0.5600 0 0 0</pose><geometry><box><size>0.6800 0.2200 1.1200</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual>
      </link>
    </model>

    <!-- Focus camera on tall pendulum -->
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>4.927360 -4.376610 3.740080 0.000000 0.275643 2.356190</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

  </world>
</sdf>
