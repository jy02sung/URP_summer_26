<?xml version="1.0" ?>
<sdf version="1.4">
  <!-- We use a custom world for the rrbot so that the camera angle is launched correctly -->

  <world name="default">
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Global light source -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- 테이블 두 개(pick_table/place_table) 완전 제거함. 반복적으로 팔이 테이블에 걸리는 문제 때문에
         사용자 요청으로 삭제 - 실측 진단(물리엔진 접촉 모니터링)으로는 테이블 충돌 자체는 0건이었고
         실제 원인은 ArUco 검출오차(~3cm) > 파지 스퀴즈 마진(0.5mm)이었지만, 테이블이라는 장애물 자체를
         없애서 그 문제의 여파(물체가 테이블 밖으로 떨어짐)를 원천 차단하는 방향으로 처리함.
         물체/마커 높이는 기존 테이블 상판 높이(z=1.15)를 그대로 유지 - main.cpp의 SAFE_Z=1.50,
         파지 접근 좌표 등 기존에 이 높이 기준으로 다 캘리브레이션되어 있어서 그대로 재사용 가능.

         aruco_box_26은 이제 model.sdf에서 static=false(동역학 물체)다. 받침이 전혀 없으면 스캔/접근
         구간 동안 중력으로 바로 낙하하므로, pick 지점(고정 좌표) 바로 아래에만 작은 pick_pedestal을
         둬서 파지 전까지만 떠받친다 - 예전 테이블처럼 팔 이동 경로 전체를 가로지르는 큰 판이 아니라
         물체 발판 크기(0.17x0.17m)라 팔 충돌 재발 우려가 적다.
         파지~내려놓기 구간은 main.cpp의 임피던스 제어(가상 스프링-댐퍼 + F/T 센서)가 양팔 스퀴즈
         마찰(grasp_offset, mu=1.2)만으로 물체를 들어 옮긴다 - 더 이상 /gazebo/set_model_state로
         pose를 강제 갱신하는 kinematic attach는 쓰지 않는다.
         place 지점(transport_pt)은 실행마다 임의 좌표라 고정 받침대를 둘 수 없다 - 내려놓기 후 손을
         벌리는 순간 그 자리에 받쳐줄 게 없으면 바닥(ground_plane)까지 낙하한다. 특정 위치에 고정해서
         쓰게 되면 그때 pick_pedestal과 동일한 방식으로 place_pedestal을 추가하면 된다. -->

    <!-- Graspable pick object: 15x15x15cm box with a 5cm ArUco id=26 marker facing the head
         camera. dynamic(model.sdf) - held by real friction/impedance grasp, not kinematic attach.
         2026-07-18 (3차 수정): 2차 시도(pick -29deg, 카메라 시야 경계)를 headless Gazebo에서
         실제 dual_arm_command로 돌려봤더니 그마저도 ArUco가 못 찾음을 확인 - main.cpp의 스캔은
         실패 시 재시도 없이 즉시 PHASE_APPROACH로 리셋되는 1회성 로직이라(runScanStep의
         SCAN_CHECK 분기), 이론상 FOV 여유(±30deg)가 있어 보여도 실제로는 -29deg가 안 됨.
         카메라 시야 경계에서 "이 정도면 되겠지"로 미세조정하는 건 매번 30초+ 걸리는 실제 Gazebo
         재현이 필요해 위험이 커서, pick 좌표를 원래 검증된 값(0.45,-0.15, -18.4deg)으로 완전히
         되돌림(z도 원래 1.225 그대로, 아무것도 안 바꿈) - 이 좌표는 프로젝트 히스토리 전체에서
         수십 회 반복 검증된 값이라 탐지 실패 위험이 없음. place는 이전과 동일(0.0823,0.4668,
         +80deg, 반지름 0.474m, waist 하드리밋 직전) - 실측 waist swing 61.6deg로 낮아짐
         (68.8deg에서 하락, pick의 waist 기여분이 줄어든 만큼). -->
    <include>
      <uri>model://aruco_box_26</uri>
      <name>aruco_box_26</name>
      <pose>0.45 -0.15 1.225 0 0 0</pose>
    </include>

    <!-- pick 지점 전용 소형 받침대(원본 그대로 복원): 물체 발판(15x15cm)보다 살짝 큰 17x17cm,
         상판 z=1.15. 파지 전(LOCATE+APPROACH) 동안만 물체를 떠받치는 용도 - 팔은 물체 바로
         위/옆으로만 접근하므로 이 작은 받침대와 충돌할 일이 없다(프로젝트 히스토리 전체에서
         검증됨). 새 pick 좌표가 다시 이 자리와 정확히 일치하므로 그대로 복원. -->
    <model name="pick_pedestal">
      <static>true</static>
      <pose>0.45 -0.15 1.10 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.17 0.17 0.10</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.17 0.17 0.10</size></box>
          </geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================================
         transport_fan_table (6차 수정, 2026-07-18): 사용자가 ㄷ자 + 평평한 상판(5차)은 마음에
         든다고 확인하고, 순수 배치/디자인만 두 가지 추가 요청함 - (1) 테이블을 로봇 쪽으로
         당겨서 로봇이 ㄷ자 파인 공간 안쪽에 들어가도록, (2) 얇은 원기둥 다리 대신 바닥부터
         상판까지 꽉 찬 원목 패널(카운터/인포데스크 느낌)로. 물체 spawn 좌표/궤적/충돌 안전마진
         재계산은 사용자가 직접 하겠다고 명시해서 이번 수정에서는 손대지 않음 - 순수 배치+디자인만.

         배치: 5차 형상(front_wall u=0.46~0.64, left/right_arm u=0.46~0.95, 로컬 u=반지름
         방향/v=접선 방향, 전체가 place 방향 +80deg로 회전된 좌표계)을 그대로 유지한 채, 세
         조각의 u범위를 전부 -0.28m 평행이동(SHIFT=0.28) - 로봇에 가장 가까운 지점이
         0.46m->0.18m로 당겨짐. 각도(회전)나 폭은 전혀 안 바꿈, 순수 위치 이동만.
         주의: 정확한 로봇 몸통(Pelvis/Torso mesh) 반경이나 다리/발(L_toe 등) 위치를 URDF
         메시 파일에서 직접 재보진 않았음(사용자가 물체/충돌 계산은 직접 하겠다고 해서) - 0.18m는
         "확실히 안 닿는 최소값"이 아니라 "많이 당겨진 값" 정도로 봐주시고, 실제로 몸통이나
         다리에 파고드는 것처럼 보이면 이 SHIFT 값만 조정하면 됨.

         하부 구조: 다리 4개(원기둥)를 전부 제거하고, 위 3개 상판 조각 각각과 정확히 같은
         (u,v) 풋프린트를 갖는 "패널" Box를 바닥(z=0)부터 상판 바닥면(z=1.12)까지 꽉 채워
         추가 - front_wall_panel/left_arm_panel/right_arm_panel. 재질은 상판과 동일한
         Gazebo/Wood.

         main.cpp/urdf 등 제어 로직은 이번에도 전혀 건드리지 않음 - 순수 world 파일 시각적
         모델링. 실행 시 반드시 `source /home/jungmin/friend_ws_88pct/devel/setup.bash`를
         먼저 하고 실행할 것(이 컴퓨터의 ~/.bashrc가 다른 워크스페이스(~/catkin_ws)를 자동
         소싱함). ============================================================ -->
    <model name="transport_fan_table">
      <static>true</static>
      <pose>0 0 0 0 0 1.3962634</pose>
      <link name="link">
        <collision name="front_wall_collision"><pose>0.2700 0.0000 1.1600 0 0 0</pose><geometry><box><size>0.1800 1.1000 0.08</size></box></geometry></collision>
        <visual name="front_wall_visual"><pose>0.2700 0.0000 1.1600 0 0 0</pose><geometry><box><size>0.1800 1.1000 0.08</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual>
        <collision name="front_wall_panel_collision"><pose>0.2700 0.0000 0.5600 0 0 0</pose><geometry><box><size>0.1800 1.1000 1.1200</size></box></geometry></collision>
        <visual name="front_wall_panel_visual"><pose>0.2700 0.0000 0.5600 0 0 0</pose><geometry><box><size>0.1800 1.1000 1.1200</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual>
        <collision name="left_arm_collision"><pose>0.4250 -0.4500 1.1600 0 0 0</pose><geometry><box><size>0.4900 0.2000 0.08</size></box></geometry></collision>
        <visual name="left_arm_visual"><pose>0.4250 -0.4500 1.1600 0 0 0</pose><geometry><box><size>0.4900 0.2000 0.08</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual>
        <collision name="left_arm_panel_collision"><pose>0.4250 -0.4500 0.5600 0 0 0</pose><geometry><box><size>0.4900 0.2000 1.1200</size></box></geometry></collision>
        <visual name="left_arm_panel_visual"><pose>0.4250 -0.4500 0.5600 0 0 0</pose><geometry><box><size>0.4900 0.2000 1.1200</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual>
        <collision name="right_arm_collision"><pose>0.4250 0.4500 1.1600 0 0 0</pose><geometry><box><size>0.4900 0.2000 0.08</size></box></geometry></collision>
        <visual name="right_arm_visual"><pose>0.4250 0.4500 1.1600 0 0 0</pose><geometry><box><size>0.4900 0.2000 0.08</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual>
        <collision name="right_arm_panel_collision"><pose>0.4250 0.4500 0.5600 0 0 0</pose><geometry><box><size>0.4900 0.2000 1.1200</size></box></geometry></collision>
        <visual name="right_arm_panel_visual"><pose>0.4250 0.4500 0.5600 0 0 0</pose><geometry><box><size>0.4900 0.2000 1.1200</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual>
      </link>
    </model>

    <!-- Focus camera on tall pendulum -->
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>4.927360 -4.376610 3.740080 0.000000 0.275643 2.356190</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

  </world>
</sdf>
