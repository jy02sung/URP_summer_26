<launch>

  <rosparam file="$(find dual_arm)/config/dual_arm_effortcontrol.yaml" command="load"/>
  <node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false"
    output="screen" ns="/dual_arm" args="joint_state_controller
                      joint1_effort_controller
                      joint2_effort_controller
                      joint3_effort_controller
                      joint4_effort_controller
                      joint5_effort_controller
                      joint7_effort_controller
                      joint8_effort_controller
                      joint9_effort_controller
                      joint10_effort_controller
                      joint12_effort_controller
                      joint13_effort_controller"/>

  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher"
    respawn="false" output="screen">
    <remap from="/joint_states" to="/dual_arm/joint_states" />
  </node>

</launch>
