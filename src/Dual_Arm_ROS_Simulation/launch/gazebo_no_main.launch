<launch>
  <arg name="paused" default="false"/>
  <arg name="use_sim_time" default="true"/>
  <arg name="gui" default="true"/>
  <arg name="headless" default="false"/>
  <arg name="debug" default="false"/>
  <arg name="spawn_delay" default="8.0"/>
  <arg name="pose_settle_delay" default="2.0"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find dual_arm)/worlds/rrbot.world"/>
    <arg name="debug" value="$(arg debug)" />
    <arg name="gui" value="$(arg gui)" />
    <arg name="paused" value="$(arg paused)"/>
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    <arg name="headless" value="$(arg headless)"/>
  </include>

  <include file="$(find dual_arm)/launch/dual_arm_control.launch" />
  <include file="$(find dual_arm)/launch/aruco_detection.launch" />

  <param name="robot_description"
    command="$(find xacro)/xacro --inorder '$(find dual_arm)/urdf/dual_arm.xacro'" />

  <node name="urdf_spawner" pkg="dual_arm" type="spawn_dual_arm_model.sh" respawn="false" output="screen"
    args="$(arg spawn_delay) dual_arm $(find dual_arm)/urdf/dual_arm.urdf"/>

  <node name="initial_pose_setter" pkg="dual_arm" type="set_initial_pose.py" respawn="false" output="screen">
    <param name="model_name" value="dual_arm"/>
    <param name="urdf_param_name" value="robot_description"/>
    <param name="settle_delay" value="$(arg pose_settle_delay)"/>
  </node>
</launch>
