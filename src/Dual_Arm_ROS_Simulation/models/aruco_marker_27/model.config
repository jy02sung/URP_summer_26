<?xml version="1.0"?>
<model>
  <name>ArUco Marker 27 (5cm, target marker)</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>
  <description>
    Static 5cm ArUco marker (dictionary id 27) used as a visual "transport
    target" decal, lying flat (facing +Z) on the pick table so it marks
    where the picked object should be placed. Not intended for detection
    by aruco_detection.launch (which is configured for id 26) - purely a
    scene landmark.
  </description>
</model>
